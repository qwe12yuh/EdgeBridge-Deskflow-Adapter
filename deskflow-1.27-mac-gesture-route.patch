+    // Remote OLE may still own a drag after the local coordinator disappears.
+    // Keep the next full click out until its watchdog has had time to cancel.
+    id.clear();
+    edgeinput::reverseArmed = 0;
+    phase = Phase::Finishing;
+    deadline = Clock::now() + 2s;
+    edgeinput::finishing = generation;
