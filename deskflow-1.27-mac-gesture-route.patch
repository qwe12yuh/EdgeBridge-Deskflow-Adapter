+// Inspect only our marked down and a cancelled gesture's balancing up. Ordinary
+// events pass unchanged. No IPC, window enumeration or blocking lookup here.
+static CGEventRef checkDestinationEvent(CGEventTapProxy, CGEventType type, CGEventRef event, void *)
+{
+  if (type == kCGEventTapDisabledByTimeout || type == kCGEventTapDisabledByUserInput) {
+    edgeinput::destinationTapReady = false;
+    edgeinput::destinationGate = 0;
+    ++edgeinput::tapFault;
+    return event;
+  }
+  if (!event) return event;
+  const uint64_t tag = CGEventGetIntegerValueField(event, kCGEventSourceUserData);
+  const auto marker = static_cast<uint32_t>(tag >> 32);
+  if (type == kCGEventLeftMouseDown && marker == edgeinput::destinationMarker) {
+    return edgeinput::annotateDestinationDown(tag, CGEventGetIntegerValueField(event, kCGEventSourceUnixProcessID),
+        CGEventGetIntegerValueField(event, kCGEventTargetUnixProcessID),
+        CGEventGetIntegerValueField(event, kCGMouseEventWindowUnderMousePointerThatCanHandleThisEvent),
+        clock_gettime_nsec_np(CLOCK_UPTIME_RAW)) ? event : nullptr;
+  }
+  if (type == kCGEventLeftMouseUp && marker == edgeinput::cleanupUpMarker) {
+    // WindowServer has processed the physical release. Do not send an orphan
+    // cleanup click to Finder or another app if the helper exited or moved.
+    return edgeinput::destinationAccepted == static_cast<uint32_t>(tag) &&
+           CGEventGetIntegerValueField(event, kCGEventTargetUnixProcessID) == edgeinput::destinationPid &&
+           CGEventGetIntegerValueField(event, kCGMouseEventWindowUnderMousePointerThatCanHandleThisEvent) ==
+               edgeinput::destinationWindow ? event : nullptr;
+  }
+  return event;
+}
