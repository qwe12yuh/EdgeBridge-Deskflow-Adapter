+using namespace std::chrono_literals;
+namespace {
+bool configure(int fd)
+{
+  return fcntl(fd, F_SETFL, O_NONBLOCK) == 0 && fcntl(fd, F_SETFD, FD_CLOEXEC) == 0;
+}
+bool sameOwnedSocket(const char *path, dev_t device, ino_t inode)
+{
+  struct stat now{};
+  return lstat(path, &now) == 0 && S_ISSOCK(now.st_mode) && now.st_uid == geteuid() &&
+         now.st_dev == device && now.st_ino == inode;
+}
+
+// A dead listener leaves its filesystem node behind on macOS. A pathname or
+// file type alone is insufficient evidence that the former listener is gone.
+bool reclaimRefusedSocket(const sockaddr_un &addr)
+{
+  struct stat before{};
+  if (lstat(addr.sun_path, &before) || !S_ISSOCK(before.st_mode) || before.st_uid != geteuid()) return false;
+  int probe = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (probe < 0) return false;
+  auto cleanup = qScopeGuard([&] { close(probe); });
+  if (!configure(probe) || connect(probe, reinterpret_cast<const sockaddr *>(&addr), sizeof(addr)) == 0) return false;
+  if (errno != ECONNREFUSED || !sameOwnedSocket(addr.sun_path, before.st_dev, before.st_ino)) return false;
+  return unlink(addr.sun_path) == 0;
+}
+bool temporary() { return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR; }
+}
+
+EdgeRoute::EdgeRoute(Screens s) : screens(std::move(s))
+{
+  auto setting = std::getenv("EDGEBRIDGE_ROUTE_SOCKET");
+  if (!setting || !*setting) return;
+  const std::filesystem::path path(setting);
+  struct stat st{};
+  sockaddr_un addr{};
+  if (!path.is_absolute() || path.string().size() >= sizeof(addr.sun_path) ||
+      lstat(path.parent_path().c_str(), &st) || !S_ISDIR(st.st_mode) ||
+      st.st_uid != geteuid() || (st.st_mode & 0077)) {
+    qWarning("experimental route requires a short absolute path inside a private directory");
+    return;
+  }
+  // Serialize check/reclaim/bind/listen between independent lab startups.
+  int dir = open(path.parent_path().c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (dir < 0) return;
+  auto closeDir = qScopeGuard([&] { close(dir); });
+  struct stat opened{};
+  if (fstat(dir, &opened) || opened.st_dev != st.st_dev || opened.st_ino != st.st_ino ||
+      flock(dir, LOCK_EX | LOCK_NB)) {
+    qWarning("experimental route directory changed or initialization is already in progress");
+    return;
+  }
+  addr.sun_family = AF_UNIX;
+  std::strcpy(addr.sun_path, path.c_str());
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) return;
+  auto closeFailed = qScopeGuard([&] { close(fd); });
+  if (!configure(fd)) return;
+  auto bindRoute = [&] { return bind(fd, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)); };
+  if (bindRoute() != 0) {
+    int error = errno;
+    if (error != EADDRINUSE || !reclaimRefusedSocket(addr) || bindRoute() != 0) {
+      qWarning("experimental route unavailable at %s (%s); an existing path is only reclaimed for a refused, owned socket",
+               addr.sun_path, strerror(error));
+      return;
+    }
+  }
+  struct stat bound{};
+  if (lstat(path.c_str(), &bound) || !S_ISSOCK(bound.st_mode) || bound.st_uid != geteuid()) return;
+  if (chmod(path.c_str(), 0600) || listen(fd, 1)) {
+    if (sameOwnedSocket(path.c_str(), bound.st_dev, bound.st_ino)) unlink(path.c_str());
+    return;
+  }
+  socketDevice = bound.st_dev;
+  socketInode = bound.st_ino;
