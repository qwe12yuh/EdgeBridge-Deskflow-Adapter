+      CHECK(step()["reason"] == "released-before-target-start");
+      CHECK(step(command("target-started",gen))["event"] == "rejected");
+    } else {
+      auto request = command("destination-start", gen);
+      request["pid"] = 100;
+      request["window"] = 200;
+      request["physicalDownEventNumber"] = downNumber;
+      auto permitted = step(request);
+      CHECK(permitted["event"] == "destination-start-permitted");
+      bool ok = false;
+      auto nonce = permitted["nonce"].toString().toULongLong(&ok,16);
+      CHECK(ok && nonce >> 32 == edgeinput::destinationMarker && permitted["expiresUptimeMs"].toDouble() > t/1.e6);
+      CHECK(step(request)["event"] == "rejected"); // cannot acquire another permit for this press
+      auto now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+      if (outcome == Outcome::WrongPid || outcome == Outcome::WrongNumber || outcome == Outcome::Expired) {
+        int sourcePid = outcome == Outcome::WrongPid ? 101 : 100;
+        auto observed = outcome == Outcome::WrongNumber ? downNumber+1 : downNumber;
+        auto timestamp = outcome == Outcome::Expired ? now + 500000000ULL : now;
+        CHECK(!edgeinput::admitDestinationDown(nonce,sourcePid,observed,timestamp));
+        CHECK(!edgeinput::admitDestinationDown(nonce,100,downNumber,now)); // cannot retry
+        auto refused = step();
+        CHECK(refused["reason"] == "destination-down-hid-rejected" && refused["sourcePid"] == sourcePid);
+        CHECK(edgeinput::up(true,now) && !edgeinput::destinationDebt);
+        CHECK(step(command("finish",gen))["event"] == "finished");
+        continue;
+      }
+      CHECK(edgeinput::admitDestinationDown(nonce, 100, downNumber, now));
+      CHECK(!edgeinput::admitDestinationDown(nonce, 100, downNumber, now)); // raw replay
+      if (outcome == Outcome::CancelAfterHid || outcome == Outcome::EarlyAfterHid || outcome == Outcome::WrongWindow) {
+        if (outcome == Outcome::CancelAfterHid) {
+          CHECK(step(command("cancel",gen))["event"] == "cancelled");
+          CHECK(!edgeinput::annotateDestinationDown(nonce,100,100,200,now));
+          CHECK(step(command("finish",gen))["event"] == "finished");
+          CHECK(!edgeinput::up(false,now)); // debt outlives lease and even active screen change
+        } else if (outcome == Outcome::WrongWindow) {
+          CHECK(!edgeinput::annotateDestinationDown(nonce,100,100,201,now));
+          CHECK(step()["reason"] == "destination-window-mismatch");
+          CHECK(!edgeinput::up(true,now));
+          CHECK(step(command("finish",gen))["event"] == "finished");
+        } else {
+          CHECK(!edgeinput::up(true,now));
+          CHECK(!edgeinput::annotateDestinationDown(nonce,100,100,200,now));
+          CHECK(step()["event"] == "cancelled");
+          CHECK(step(command("finish",gen))["event"] == "finished");
+        }
+        CHECK(!edgeinput::destinationDebt && edgeinput::reverseDelivered != static_cast<uint64_t>(gen));
+        continue;
+      }
+      CHECK(edgeinput::annotateDestinationDown(nonce,100,100,200,now));
+      CHECK(!edgeinput::annotateDestinationDown(nonce,100,100,200,now));
+      CHECK(step(command("target-started",gen))["event"] == "target-armed");
+      if (outcome == Outcome::Disconnect) {
+        close(fd);
+        route.poll();
+        CHECK(!edgeinput::up(true) && edgeinput::reverseDelivered != static_cast<uint64_t>(gen)); // balance only
+        break;
+      }
+      if (outcome == Outcome::Escape) {
+        CHECK(!edgeinput::escape()); // allow physical Escape into AppKit itself
+        CHECK(step()["reason"] == "escape");
+        CHECK(!edgeinput::up(true) && edgeinput::reverseDelivered != static_cast<uint64_t>(gen)); // balance only
+      } else {
+        QJsonObject native = command("target-ended",gen);
+        uint64_t upTime = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        if (outcome == Outcome::StalePhysicalClock) upTime -= 4000000000ULL;
+        double upMs = upTime / 1.e6;
+        native["nativeEndedUptimeMs"] = upMs;
+        auto previousGeneration = native;
+        previousGeneration["generation"] = gen - 1;
+        CHECK(step(previousGeneration)["reason"] == "stale-session" && edgeinput::reverseArmed == gen);
+        if (outcome == Outcome::EarlyNative) {
+          CHECK(step(native)["reason"] == "native-ended-before-physical-up");
+          CHECK(!edgeinput::reverseArmed && !edgeinput::up(true, upTime) && edgeinput::reverseDelivered != static_cast<uint64_t>(gen)); // no later successful release
+        } else if (outcome == Outcome::RacingUp) {
+          releaseDuringProgress = upTime;
+          auto count = replies.size();
+          step(native);
+          CHECK(replies.size() == count+2 && replies[count]["event"] == "target-ended-verified");
+          CHECK(replies[count+1]["event"] == "ended" && replies[count+1]["physicalUpUptimeMs"] == upMs);
+        } else {
+          CHECK(!edgeinput::up(true,upTime,upNumber) && edgeinput::reverseDelivered == static_cast<uint64_t>(gen));
+          auto ended = step();
+          CHECK(ended["event"] == "ended" && ended["physicalUpUptimeMs"] == upMs);
+          CHECK(ended["physicalDownEventNumber"].toInteger(-1) == downNumber);
+          CHECK(ended["physicalUpEventNumber"].toInteger(-1) == upNumber);
+          CHECK(ended["physicalEventNumberPair"] == (!downNumber ? "unavailable" : upNumber == downNumber ? "matched" : "mismatched"));
+          if (outcome == Outcome::Success) {
+            // Subsequent suppressed button edges must not replace the old release timestamp.
+            CHECK(edgeinput::down(upTime+1) && edgeinput::up(true,upTime+2));
+            auto ack = step(native);
+            CHECK(ack["event"] == "target-ended-verified" &&
+                  ack["nativeEndedUptimeMs"] == upMs && ack["physicalUpUptimeMs"] == upMs);
+          } else {
+            bool late = outcome == Outcome::LateReport;
+            if (outcome == Outcome::StalePhysicalClock) {
+              // A fresh native callback cannot validate a release from an old or mismatched clock domain.
+              native["nativeEndedUptimeMs"] = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1.e6;
+            } else native["nativeEndedUptimeMs"] = late ? upMs - 1 : upMs + 5000;
+            CHECK(step(native)["reason"] == (late ? "native-ended-before-physical-up" : "invalid-native-end-timestamp"));
+            CHECK(!edgeinput::reverseArmed);
+          }
+        }
+      }
+    }
+    CHECK(edgeinput::down(t+1));
+    CHECK(step(command("finish",gen))["event"] == "finished");
+    CHECK(edgeinput::up(true)); // whole next click remains paired through cleanup
+  }
+  std::puts("PASS: forward and reverse actual socket, scoped source commit, Mac target arming, release, Esc and EOF");
+}
