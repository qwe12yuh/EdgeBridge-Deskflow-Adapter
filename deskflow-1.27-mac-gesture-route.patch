+    // establish a drag; only the Windows virtual pointer can arm its left edge.
+    for (int i = 0; i < 3; ++i) edgeinput::offscreenMotion(-2, 0);
+    step({{"command","heartbeat"}});
+    CHECK(hints.size() == n);
+    winX = 80;
+    step();
+    CHECK(hints.size() == n+1 && hints.back()["source"] == "win" &&
+          hints.back()["target"] == "mac" && hints.back()["edge"] == "left");
+    QJsonObject offer{{"command","prepare"},{"id",id},{"source","win"},{"target","mac"},
+                      {"edge","left"},{"observedGeneration",gen},{"observedUptimeMs",hints.back()["observedUptimeMs"]}};
+    auto wrong = offer;
+    wrong["source"] = "mac";
+    CHECK(step(wrong)["event"] == "rejected");
+    CHECK(step(offer)["event"] == "prepared");
+    winX = 0;
+    route.secondaryMotion(0, 0, -5); // crossing before Ready cannot commit
+    CHECK(step(command("ready",gen))["event"] == "ready");
+    route.secondaryMotion(0, 0, 1);
+    CHECK(step().isEmpty());
+    route.secondaryMotion(-3, 0, -3);
+    auto commit = step();
+    CHECK(commit["event"] == "commit" && commit["edge"] == "left" && !edgeinput::permit);
+    auto accepted = command("source-accepted",gen);
+    accepted["commitToken"] = outcome == Outcome::WrongToken ? QJsonValue("old") : commit["commitToken"];
+    if (outcome == Outcome::WrongToken) {
+      CHECK(step(accepted)["event"] == "cancelled" && current == "win");
+      CHECK(!edgeinput::up(false));
+      continue;
+    }
+    auto entered = step(accepted);
+    CHECK(entered["event"] == "entered" && current == "mac");
+    CHECK(entered["physicalDownEventNumber"].toInteger(-1) == downNumber);
+    if (outcome == Outcome::EarlyUp) {
