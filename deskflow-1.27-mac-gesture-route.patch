+// SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+#include "platform/OSXAutoTypes.h"
+
+#include <QSemaphore>
+#include <atomic>
+#include <cstdio>
+
+// Pure read of keyboard metadata; no display, event tap or input synthesis.
+int main(int argc, char **argv)
+{
+  QCoreApplication app(argc, argv);
+  std::atomic<unsigned> checks{0};
+  auto readLayout = [&] {
+    if (!pthread_main_np()) return;
+    AutoTISInputSourceRef layout(TISCopyCurrentKeyboardLayoutInputSource(), CFRelease);
+    if (layout && TISGetInputSourceProperty(layout.get(), kTISPropertyInputSourceID)) ++checks;
+  };
+  onTisMainThread(readLayout);
+  QSemaphore shutdown;
+  auto worker = std::unique_ptr<QThread>(QThread::create([&] {
+    onTisMainThread(readLayout);
+    QMetaObject::invokeMethod(&app, &QCoreApplication::quit, Qt::QueuedConnection);
+    shutdown.acquire();
+    onTisMainThread(readLayout);
+  }));
+  worker->start();
+  app.exec();
+  shutdown.release();
+  joinMacCoreThread(*worker);
+  if (checks != 3) return 1;
+  std::puts("PASS: real TIS reads on main, from worker, and after Qt event loop shutdown");
+}
