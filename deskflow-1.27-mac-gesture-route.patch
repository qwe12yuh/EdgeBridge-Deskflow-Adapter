+// SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+#include "server/EdgeRoute.h"
+#include <QTemporaryDir>
+#include <QFile>
+#include <cstdio>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#define CHECK(value) do { if (!(value)) { std::fprintf(stderr, "failure at line %d\n", __LINE__); return 1; } } while (false)
+int main()
+{
+  QTemporaryDir temp("/tmp/df-route-lifecycle-XXXXXX");
+  CHECK(temp.isValid());
+  auto path = (temp.path() + "/route.sock").toUtf8();
+  setenv("EDGEBRIDGE_ROUTE_SOCKET", path.constData(), 1);
+  sockaddr_un addr{};
+  addr.sun_family = AF_UNIX;
+  std::strcpy(addr.sun_path, path.constData());
+  int original = socket(AF_UNIX, SOCK_STREAM, 0);
+  CHECK(original >= 0 && bind(original, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) == 0);
+  CHECK(listen(original, 1) == 0);
+  struct stat before{}, after{};
+  CHECK(lstat(path, &before) == 0);
+  { EdgeRoute second({}); CHECK(!second.listening()); }
+  CHECK(lstat(path, &after) == 0 && before.st_ino == after.st_ino);
+  int probed = accept(original, nullptr, nullptr);
+  CHECK(probed >= 0); // existing endpoint served a real probe; it survived
+  close(probed);
+  close(original); // stale node, equivalent to abrupt process termination
+  CHECK(lstat(path, &after) == 0 && S_ISSOCK(after.st_mode));
+  {
+    EdgeRoute replacement({});
+    CHECK(replacement.listening());
+    int client = socket(AF_UNIX, SOCK_STREAM, 0);
+    CHECK(connect(client, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) == 0);
+    close(client);
+  }
+  CHECK(lstat(path, &after) != 0 && errno == ENOENT);
+  QFile ordinary(QString::fromUtf8(path));
+  CHECK(ordinary.open(QIODevice::NewOnly | QIODevice::WriteOnly) && ordinary.write("keep") == 4);
+  ordinary.close();
+  { EdgeRoute collision({}); CHECK(!collision.listening()); }
+  CHECK(ordinary.open(QIODevice::ReadOnly) && ordinary.readAll() == "keep");
+  ordinary.close();
+  auto alias = (temp.path() + "/alias.sock").toUtf8();
+  CHECK(symlink(path.constData(), alias.constData()) == 0);
+  setenv("EDGEBRIDGE_ROUTE_SOCKET", alias.constData(), 1);
+  { EdgeRoute symlinkCollision({}); CHECK(!symlinkCollision.listening()); }
+  CHECK(lstat(alias, &after) == 0 && S_ISLNK(after.st_mode));
+  std::puts("PASS: protected active listener, reclaimed refused socket, preserved ordinary file and symlink");
+}
