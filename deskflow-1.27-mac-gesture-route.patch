+#pragma once
+#include <QByteArray>
+#include <QJsonObject>
+#include <QString>
+#include <chrono>
+#include <functional>
+#include <optional>
+#include <string>
+#include <sys/types.h>
+
+class EdgeRoute
+{
+public:
+  struct Entry {
+    int edge, x, y, sourceX;
+    bool fromPrimary;
+    QString source, target;
+  };
+  struct Screens {
+    std::function<std::optional<Entry>()> map;
+    std::function<bool(const std::string &, const Entry &)> enter;
+    std::function<bool()> onPrimary;
+    std::function<std::string()> current;
+  };
+  explicit EdgeRoute(Screens screens);
+  ~EdgeRoute();
+  bool listening() const { return listener >= 0; }
+  bool active() const { return phase != Phase::Idle; }
+  void poll();
+  void secondaryMotion(int x, int leftEdge, int dx);
+  void targetLost(const std::string &name);
+  void stop(const QString &reason, QJsonObject detail = {});
+private:
+  using Clock = std::chrono::steady_clock;
+  enum class Phase { Idle, Prepared, Ready, Committing, Entered, Finishing };
+  void command(const QJsonObject &);
+  void verifyTargetEnd(const QJsonObject &);
+  void progress();
+  void candidate();
+  bool stillAt(const Entry &) const;
+  bool sameRoute(const Entry &) const;
+  void notify(const QString &, QJsonObject = {});
+  void reject(const QString &, const QString &);
+  void enqueue(const QJsonObject &);
+  void closePeer();
+  void reset();
+  Screens screens;
+  int listener = -1, peer = -1;
+  std::string socketPath;
+  dev_t socketDevice{};
+  ino_t socketInode{};
+  QByteArray input, output;
+  QString id, source, target, commitToken;
+  bool reverse = false;
+  Phase phase = Phase::Idle;
+  qint64 generation = 0, lastPrepared = 0, seq = 0;
+  uint64_t baseline = 0, tapGeneration = 0;
+  qint64 candidateGeneration = 0;
+  qint64 physicalDownEventNumber = 0;
+  uint64_t leftOutward = 0;
+  QString candidateSource, candidateTarget, candidateEdge;
+  Clock::time_point heartbeat, deadline, nextCandidate;
+};
