+EdgeRoute::~EdgeRoute()
+{
+  if (listener < 0) return;
+  closePeer();
+  reset();
+  edgeinput::enabled = false;
+  if (sameOwnedSocket(socketPath.c_str(), socketDevice, socketInode)) unlink(socketPath.c_str());
+  close(listener);
