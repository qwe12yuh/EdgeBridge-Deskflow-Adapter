+// SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+
+// The Quartz HID callback is the sole writer of button edges. The server's
+// Deskflow event-queue thread manages the lease. Neither thread waits for IPC.
+namespace edgeinput {
+inline std::atomic<bool> enabled{false};
+inline std::atomic<uint64_t> downTimeNs{0};
+inline std::atomic<int64_t> downNumber{0}, reverseUpNumber{0};
+inline std::atomic<uint64_t> button{0}; // (generation << 1) | held
+inline std::atomic<uint64_t> permit{0}, consumed{0}, escaped{0}, leased{0};
+inline std::atomic<bool> consumeEscapeUp{false}, suppressedPress{false};
+// A reverse handoff owns the up only after the Windows source acknowledged
+// its local drop. AppKit receives it after its own willBeginAt callback.
+inline std::atomic<uint64_t> reverseOwned{0}, reverseArmed{0}, reverseDelivered{0};
+// Preserve the delivered release through any later click swallowed by the
+// cleanup guard. Compare only local CLOCK_UPTIME_RAW samples with AppKit's
+// systemUptime. The CGEvent timestamp is opaque diagnostic data.
+inline std::atomic<uint64_t> reverseUpTimeNs{0}, reverseRawUpStamp{0};
+inline std::atomic<int> reverseUpQuartzX{0}, reverseUpQuartzY{0};
+inline std::atomic<unsigned> reverseMoves{0}, reverseDrags{0};
+inline std::atomic<int> travelX{0}, travelY{0};
+inline std::atomic<uint64_t> finishing{0}, tapFault{0};
+inline std::atomic<int> boundary{std::numeric_limits<int>::max()};
+inline std::atomic<uint64_t> outward{0};
+inline std::atomic<bool> atBoundary{false};
+inline std::atomic<uint64_t> downSeen{0}, dragSeen{0}, acceptedDrags{0}, draggedGeneration{0};
+inline std::atomic<int> startX{0}, startY{0}, dragX{0};
+constexpr uint32_t marker = 0x45424745;
+// A start has two destructive gates: HID admits the tagged event into the
+// login session, then an annotated tap checks the actual WindowServer target.
+// The HID debt is independent of the route lease: cleanup must let the real
+// up balance a down even after cancellation, timeout or coordinator EOF.
+constexpr uint32_t destinationMarker = 0x45424453;
+constexpr uint32_t cleanupUpMarker = 0x45424455;
+inline std::atomic<bool> destinationTapReady{false};
+inline std::atomic<uint64_t> destinationGate{0}, destinationGen{0}, destinationExpiry{0};
+inline std::atomic<uint64_t> destinationDebt{0}, destinationAccepted{0}, destinationRejected{0};
+inline std::atomic<int64_t> destinationPid{0}, destinationWindow{0};
+inline std::atomic<int64_t> observedSourcePid{0}, observedTargetPid{0}, observedTargetWindow{0}, observedNumber{0};
+inline std::atomic<uint64_t> destinationHidRejected{0};
+inline bool destinationHeld(uint64_t gen, uint64_t now)
+{
+  return gen && destinationTapReady && leased == gen && reverseOwned == gen &&
+         escaped != gen && button == gen * 2 + 1 && now <= destinationExpiry.load();
+}
+inline bool admitDestinationDown(uint64_t nonce, int64_t pid, int64_t number, uint64_t now)
+{
+  const auto gen = destinationGen.load();
+  if (destinationGate.load() != nonce) return false;
+  if (!destinationHeld(gen, now) || !pid || pid != destinationPid || number != downNumber) {
+    observedSourcePid = pid;
+    observedNumber = number;
+    destinationHidRejected = gen;
+    destinationGate.compare_exchange_strong(nonce, 0);
+    return false;
+  }
+  if (!destinationGate.compare_exchange_strong(nonce, ~nonce)) return false;
+  destinationDebt = gen;
+  return true;
+}
+inline bool annotateDestinationDown(uint64_t nonce, int64_t sourcePid, int64_t targetPid, int64_t window, uint64_t now)
+{
+  const auto gen = destinationGen.load();
+  auto pending = ~nonce;
+  if (!destinationGate.compare_exchange_strong(pending, 0)) return false;
+  if (!destinationHeld(gen, now) || destinationDebt != gen || sourcePid != destinationPid ||
+      targetPid != destinationPid || window != destinationWindow) {
+    observedSourcePid = sourcePid;
+    observedTargetPid = targetPid;
+    observedTargetWindow = window;
+    destinationRejected = gen;
+    return false;
+  }
+  destinationAccepted = gen;
+  return true;
+}
+inline bool tookSourceLeft()
+{
+  auto gen = button.load() >> 1;
+  return gen != 0 && consumed.load() == gen;
+}
+inline bool down(uint64_t timestampNs, int x = 0, int y = 0, int64_t eventNumber = 0)
+{
+  auto state = button.load();
+  if (!(state & 1)) {
+    // A tap-disable interval can hide an up. A fresh physical press cannot
+    // inherit any accounting or annotation from the preceding press.
+    destinationDebt = 0;
+    startX = x;
+    startY = y;
+    travelX = 0;
+    travelY = 0;
+    downTimeNs = timestampNs;
+    downNumber = eventNumber;
+    button = ((state >> 1) + 1) * 2 + 1;
+    atBoundary = false;
+    auto draining = finishing.load();
+    suppressedPress = draining && leased.load() == draining;
+  }
+  return suppressedPress.load();
+}
+inline bool up(bool onPrimary = false, uint64_t timeNs = 0, int64_t eventNumber = 0)
+{
+  auto state = button.load();
+  bool suppress = suppressedPress.exchange(false);
+  auto gen = state >> 1;
+  bool returning = reverseOwned.load() == gen;
+  if ((state & 1) && !suppress && (returning || consumed.load() == gen)) {
+    // Arm before the next HID down can arrive, even if the routing queue is busy.
+    if (leased.load() == gen) finishing = gen;
+    suppress = true;
+    if (returning && onPrimary && leased.load() == gen && escaped.load() != gen && reverseArmed.load() == gen) {
+      reverseUpTimeNs = timeNs >= downTimeNs.load() ? timeNs : 0;
+      reverseUpNumber = eventNumber;
+      reverseDelivered = gen;
+      suppress = false; // deliver this physical up to the armed AppKit session
+    }
+  }
+  // Publish the released state only after its generation and timestamp, so
+  // the independent Deskflow event queue cannot observe a half-written up.
+  if (gen && destinationDebt.load() == gen) {
+    destinationDebt = 0;
+    suppress = false;
+  }
+  button = state & ~uint64_t{1};
+  return suppress;
+}
+inline void leftDrag(int x, int y, int dx, int dy)
+{
+  ++acceptedDrags;
+  auto state = button.load();
+  if (!(state & 1) || suppressedPress) return;
+  dragX = x;
+  // An actual left-drag event is necessary. Include raw deltas for a cursor
+  // that has already been clamped against the physical right edge.
+  if (std::abs(x - startX.load()) + std::abs(y - startY.load()) >= 6 ||
+      std::abs(dx) + std::abs(dy) >= 6) draggedGeneration = state >> 1;
+}
+inline void offscreenMotion(int dx, int dy)
+{
+  auto state = button.load();
+  if (!(state & 1) || suppressedPress || draggedGeneration == (state >> 1)) return;
+  // Cursor coordinates on a secondary are virtual. Raw HID deltas survive
+  // Deskflow's primary cursor freeze and also cover slow sub-threshold steps.
+  travelX += dx;
+  travelY += dy;
+  if (std::abs(travelX.load()) + std::abs(travelY.load()) >= 6) draggedGeneration = state >> 1;
+}
+inline void motion(int x, int dx)
+{
+  atBoundary = x >= boundary.load();
+  if (atBoundary && dx > 0 && (button.load() & 1)) ++outward;
+}
+inline bool acceptMarker(uint64_t gen, int x)
+{
+  if (!gen || button.load() != gen * 2 + 1 || x < boundary.load() ||
+      !atBoundary || escaped.load() == gen || !permit.compare_exchange_strong(gen, 0)) return false;
+  consumed = gen;
+  return true;
+}
+inline bool escape()
+{
+  auto state = button.load();
+  if (!(state & 1) || leased.load() != (state >> 1)) return false;
+  escaped = state >> 1;
+  bool capture = consumed.load() == (state >> 1) ||
+                 (reverseOwned.load() == (state >> 1) && reverseArmed.load() != (state >> 1));
+  consumeEscapeUp = capture;
+  return capture;
+}
+}
