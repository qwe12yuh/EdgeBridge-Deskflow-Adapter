+    if (reverse) edgeinput::reverseOwned = generation;
+    if (!screens.enter(target.toStdString(), *entry)) { stop("switch-failed"); return; }
+    phase = Phase::Entered;
+    deadline = Clock::now() + 2s;
+    QJsonObject entered{{"x", entry->x}, {"y", entry->y}, {"target", target}};
+    if (reverse) entered.insert("physicalDownEventNumber", physicalDownEventNumber);
+    notify("entered", entered);
+    return;
+  }
+  reject(requestId, "unexpected-command");
+}
+void EdgeRoute::verifyTargetEnd(const QJsonObject &message)
+{
+  const auto gen = static_cast<uint64_t>(generation);
+  const auto now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1.e6;
+  const auto native = message.value("nativeEndedUptimeMs").toDouble(-1);
+  // The release may already have been delivered by Quartz while the server's
+  // periodic progress() has not emitted its "ended" notification yet.
+  const bool delivered = edgeinput::reverseDelivered.load() == gen;
+  const auto physical = delivered ? edgeinput::reverseUpTimeNs.load() / 1.e6 : 0.0;
+  QString error;
+  if ((phase != Phase::Entered && phase != Phase::Finishing) || edgeinput::reverseArmed != gen)
+    error = "native-end-without-armed-target";
+  else if (!delivered)
+    error = "native-ended-before-physical-up";
+  else if (!std::isfinite(native) || native <= 0 || native > now || now - native > 2000 ||
+           physical <= 0 || physical > now || now - physical > 2000)
+    error = "invalid-native-end-timestamp";
+  else if (native < physical)
+    error = "native-ended-before-physical-up";
+  if (!error.isEmpty()) {
+    edgeinput::reverseArmed = 0;
+    if (phase == Phase::Finishing) {
+      // Preserve the existing click quarantine until cleanup is acknowledged.
+      notify("cancelled", {{"reason",error}});
+    } else stop(error);
+    return;
+  }
+  notify("target-ended-verified", {{"physicalUpUptimeMs",physical},{"nativeEndedUptimeMs",native}});
+}
+void EdgeRoute::progress()
+{
+  if (!active()) return;
+  auto gen = static_cast<uint64_t>(generation);
+  if (phase == Phase::Finishing) {
+    if (Clock::now() >= deadline) stop("finish-timeout");
+    return;
+  }
+  if (edgeinput::tapFault != tapGeneration) { stop("event-tap-interrupted"); return; }
+  if (edgeinput::destinationHidRejected == gen) {
+    stop("destination-down-hid-rejected", {{"sourcePid",qint64(edgeinput::observedSourcePid.load())},
+         {"eventNumber",qint64(edgeinput::observedNumber.load())}});
+    return;
+  }
+  if (edgeinput::destinationRejected == gen) {
+    stop("destination-window-mismatch", {{"sourcePid",qint64(edgeinput::observedSourcePid.load())},
+         {"targetPid",qint64(edgeinput::observedTargetPid.load())},
+         {"targetWindow",qint64(edgeinput::observedTargetWindow.load())}});
+    return;
+  }
+  if (edgeinput::escaped == gen) { stop("escape"); return; }
+  if (edgeinput::button != gen * 2 + 1) {
+    if (phase == Phase::Entered) {
+      if (reverse && edgeinput::reverseDelivered != gen) { stop("released-before-target-start"); return; }
+      QJsonObject ended{{"reason", "released"}};
+      if (reverse) {
+        ended.insert("physicalUpUptimeMs", edgeinput::reverseUpTimeNs.load() / 1.e6);
+        const qint64 upNumber = edgeinput::reverseUpNumber.load();
+        ended.insert("physicalDownEventNumber", physicalDownEventNumber);
+        ended.insert("physicalUpEventNumber", upNumber);
+        QString pairing = "unavailable";
+        if (physicalDownEventNumber != 0 && upNumber != 0)
+          pairing = physicalDownEventNumber == upNumber ? "matched" : "mismatched";
+        ended.insert("physicalEventNumberPair", pairing);
+        ended.insert("physicalUpRawEventTimestamp", QString::number(edgeinput::reverseRawUpStamp.load()));
+        ended.insert("physicalUpQuartzX", edgeinput::reverseUpQuartzX.load());
+        ended.insert("physicalUpQuartzY", edgeinput::reverseUpQuartzY.load());
+        ended.insert("primaryMouseMoved", static_cast<qint64>(edgeinput::reverseMoves.load()));
+        ended.insert("primaryLeftDragged", static_cast<qint64>(edgeinput::reverseDrags.load()));
+      }
+      notify("ended", ended);
+      phase = Phase::Finishing;
+      deadline = Clock::now() + 2s;
+    } else stop("released-before-entry");
+    return;
+  }
+  if (Clock::now() - heartbeat > 2s) { stop("heartbeat-expired"); return; }
+  if (phase != Phase::Entered && Clock::now() >= deadline) { stop("prepare-timeout"); return; }
+  if (phase == Phase::Entered) {
+    if (screens.current() != target.toStdString()) stop("target-left");
+    else if (reverse && edgeinput::reverseArmed != gen && Clock::now() >= deadline) stop("target-start-timeout");
+    return;
+  }
+  auto entry = screens.map();
+  if (!entry || !sameRoute(*entry)) { stop("source-left"); return; }
+  bool atEdge = stillAt(*entry);
+  if (phase == Phase::Committing && !atEdge) { stop("edge-left"); return; }
+  if (phase != Phase::Ready || !atEdge || (reverse ? leftOutward : edgeinput::outward.load()) == baseline) return;
+  phase = Phase::Committing;
+  deadline = Clock::now() + 2s;
+  if (reverse) {
+    commitToken = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    notify("commit", {{"commitToken",commitToken}});
+  } else {
+    edgeinput::permit = gen;
+    notify("commit");
+  }
+}
+bool EdgeRoute::sameRoute(const Entry &entry) const
+{
+  return entry.fromPrimary != reverse && entry.source == source && entry.target == target;
+}
+bool EdgeRoute::stillAt(const Entry &entry) const
+{
+  return entry.fromPrimary ? edgeinput::atBoundary.load() : entry.sourceX <= entry.edge;
+}
+void EdgeRoute::secondaryMotion(int x, int leftEdge, int dx)
+{
+  // Called by the normal Deskflow motion queue after applying the raw delta
+  // to the secondary's virtual pointer and before clamping it to the screen.
+  if (reverse && phase == Phase::Ready && dx < 0 && x <= leftEdge) ++leftOutward;
+}
+void EdgeRoute::candidate()
+{
+  auto state = edgeinput::button.load();
+  auto gen = static_cast<qint64>(state >> 1);
+  const auto now = Clock::now();
+  bool eligible = (state & 1) && now - heartbeat < 2s && !edgeinput::suppressedPress &&
+                  gen != 0 && edgeinput::draggedGeneration == static_cast<uint64_t>(gen) &&
+                  edgeinput::escaped != static_cast<uint64_t>(gen) &&
+                  (phase == Phase::Prepared || phase == Phase::Ready || phase == Phase::Committing ||
+                   (phase == Phase::Idle && lastPrepared != gen && !edgeinput::tookSourceLeft()));
+  auto entry = eligible ? screens.map() : std::nullopt;
+  if (entry) {
+    int distance = entry->fromPrimary ? entry->edge - edgeinput::dragX.load() : entry->sourceX - entry->edge;
+    if (distance < 0 || distance > 128) entry.reset();
+  }
+  if (candidateGeneration && (!entry || candidateGeneration != gen || candidateSource != entry->source ||
+                              candidateTarget != entry->target)) {
+    enqueue({{"event","candidate-ended"},{"generation",candidateGeneration},{"seq",++seq},
+             {"source",candidateSource},{"target",candidateTarget},{"edge",candidateEdge}});
+    candidateGeneration = 0;
+  }
+  if (!entry || (candidateGeneration == gen && now < nextCandidate)) return;
+  candidateGeneration = gen;
+  candidateSource = entry->source;
+  candidateTarget = entry->target;
+  candidateEdge = entry->fromPrimary ? "right" : "left";
+  nextCandidate = now + 100ms;
+  enqueue({{"event","candidate"},{"generation",gen},{"held",true},{"leaseMs",300},{"seq",++seq},
+           {"source",candidateSource},{"target",candidateTarget},{"edge",candidateEdge},
+           {"observedUptimeMs",clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1000000.0}});
+}
+void EdgeRoute::poll()
+{
+  if (id.isEmpty() && phase == Phase::Finishing && Clock::now() >= deadline) reset();
+  if (peer < 0) {
+    int fd = accept(listener, nullptr, nullptr);
+    if (fd < 0) return;
+    uid_t uid;
+    gid_t gid;
+    int one = 1;
+    if (!configure(fd) || getpeereid(fd, &uid, &gid) || uid != geteuid() ||
+        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one))) { close(fd); return; }
+    peer = fd;
+    heartbeat = Clock::now();
+  }
+  char chunk[4096];
+  auto n = recv(peer, chunk, sizeof(chunk), 0);
+  if (n == 0 || (n < 0 && !temporary())) { closePeer(); return; }
+  if (n > 0) input.append(chunk, n);
+  if (input.size() > 16384 || output.size() > 16384) { closePeer(); return; }
+  progress();
+  for (int lines = 0; lines < 20; ++lines) {
+    auto split = input.indexOf('\n');
+    if (split < 0) break;
+    auto doc = QJsonDocument::fromJson(input.left(split));
+    input.remove(0, split + 1);
+    if (!doc.isObject()) { closePeer(); return; }
+    command(doc.object());
+    progress();
+  }
+  candidate();
+  if (!output.isEmpty()) {
+    auto sent = send(peer, output.constData(), output.size(), 0);
+    if (sent > 0) output.remove(0, sent);
+    else if (sent == 0 || !temporary()) closePeer();
+  }
+}
