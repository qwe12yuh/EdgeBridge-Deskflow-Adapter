+// SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+#include "deskflow/EdgeRouteInput.h"
+#include <cstdio>
+#include <semaphore>
+#include <thread>
+
+// Exercise the HID writer / Deskflow reader independently. Once the reader
+// sees "released", the generation and original release time must be visible.
+int main()
+{
+  std::binary_semaphore armed(0), observed(0);
+  constexpr uint64_t rounds = 2000;
+  bool writerOK = true, readerOK = true;
+  std::thread hid([&] {
+    for (uint64_t gen = 1; gen <= rounds; ++gen) {
+      edgeinput::finishing = 0;
+      edgeinput::leased = 0;
+      if (edgeinput::down(gen * 1000)) writerOK = false;
+      edgeinput::leased = gen;
+      edgeinput::reverseOwned = gen;
+      edgeinput::reverseArmed = gen;
+      armed.release();
+      if (edgeinput::up(true, gen * 1000 + 300)) writerOK = false;
+      observed.acquire();
+    }
+  });
+  for (uint64_t gen = 1; gen <= rounds; ++gen) {
+    armed.acquire();
+    while ((edgeinput::button.load() & 1) != 0) std::this_thread::yield();
+    if (edgeinput::reverseDelivered != gen || edgeinput::reverseUpTimeNs != gen * 1000 + 300) readerOK = false;
+    observed.release();
+  }
+  hid.join();
+  if (!writerOK || !readerOK) return 1;
+  std::puts("PASS: released state publishes the matching HID generation and nanosecond timestamp");
+}
