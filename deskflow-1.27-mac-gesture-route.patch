+void EdgeRoute::reset()
+{
+  edgeinput::permit = 0;
+  edgeinput::destinationGate = 0;
+  edgeinput::reverseArmed = 0;
+  edgeinput::leased = 0;
+  edgeinput::finishing = 0;
+  phase = Phase::Idle;
+  id.clear();
+  source.clear();
+  target.clear();
+  commitToken.clear();
+  reverse = false;
