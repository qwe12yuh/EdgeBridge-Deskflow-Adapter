+    const int downNumber = outcome == Outcome::StalePhysicalClock ? 0 : -1234;
+    const int upNumber = outcome == Outcome::FutureReport ? 1235 : downNumber;
+    CHECK(!edgeinput::down(outcome == Outcome::StalePhysicalClock ? t - 10000000000ULL : t, 500, 400, downNumber));
+    auto gen = static_cast<int>(edgeinput::button.load() >> 1);
+    auto n = hints.size();
