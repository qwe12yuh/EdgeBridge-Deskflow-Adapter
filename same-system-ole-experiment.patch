new file mode 100644
index 0000000..42316b9
--- /dev/null
+++ b/src/lib/server/WinRoutePipe.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <cstdint>
+#include <vector>
+
+class WinRoutePipe
+{
+public:
+  WinRoutePipe() = default;
+  WinRoutePipe(const WinRoutePipe &) = delete;
+  WinRoutePipe &operator=(const WinRoutePipe &) = delete;
+  ~WinRoutePipe() { if (handle != INVALID_HANDLE_VALUE) CloseHandle(handle); }
+
+  bool listen(const wchar_t *name)
+  {
+    if (listening()) return false;
+    HANDLE token;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return false;
+    DWORD size = 0;
+    GetTokenInformation(token, TokenUser, nullptr, 0, &size);
+    std::vector<uintptr_t> tokenData((size + sizeof(uintptr_t) - 1) / sizeof(uintptr_t));
+    const bool haveUser = size && GetTokenInformation(token, TokenUser, tokenData.data(), size, &size);
+    CloseHandle(token);
+    if (!haveUser) return false;
+    const auto sid = reinterpret_cast<const TOKEN_USER *>(tokenData.data())->User.Sid;
+    const auto aclSize = sizeof(ACL) + sizeof(ACCESS_ALLOWED_ACE) - sizeof(DWORD) + GetLengthSid(sid);
+    std::vector<uintptr_t> aclBuffer((aclSize + sizeof(uintptr_t) - 1) / sizeof(uintptr_t));
+    const auto acl = reinterpret_cast<PACL>(aclBuffer.data());
+    SECURITY_DESCRIPTOR descriptor{};
+    if (!InitializeAcl(acl, static_cast<DWORD>(aclSize), ACL_REVISION) ||
+        !AddAccessAllowedAce(acl, ACL_REVISION, FILE_GENERIC_READ | FILE_GENERIC_WRITE, sid) ||
+        !InitializeSecurityDescriptor(&descriptor, SECURITY_DESCRIPTOR_REVISION) ||
+        !SetSecurityDescriptorDacl(&descriptor, TRUE, acl, FALSE)) return false;
+    SECURITY_ATTRIBUTES attrs{sizeof(SECURITY_ATTRIBUTES), &descriptor, FALSE};
+    handle = CreateNamedPipeW(name, PIPE_ACCESS_DUPLEX | FILE_FLAG_FIRST_PIPE_INSTANCE,
+             PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_NOWAIT | PIPE_REJECT_REMOTE_CLIENTS,
+             1, 16384, 16384, 0, &attrs);
+    return listening();
+  }
+  bool listening() const { return handle != INVALID_HANDLE_VALUE; }
+  bool accept()
+  {
+    if (connected) return true;
+    if (ConnectNamedPipe(handle, nullptr)) return connected = true;
+    const auto error = GetLastError();
+    if (error == ERROR_PIPE_CONNECTED) return connected = true;
+    if (error == ERROR_NO_DATA) DisconnectNamedPipe(handle);
+    return false;
+  }
+  void disconnect()
+  {
+    if (connected) DisconnectNamedPipe(handle);
+    connected = false;
+  }
+  int read(char *chunk, DWORD size) const
+  {
+    DWORD available = 0;
+    if (!PeekNamedPipe(handle, nullptr, 0, nullptr, &available, nullptr)) return -1;
+    if (!available) return 0;
+    DWORD received = 0;
+    if (!ReadFile(handle, chunk, available < size ? available : size, &received, nullptr)) return -1;
+    return static_cast<int>(received);
+  }
+  int write(const char *chunk, DWORD size) const
+  {
+    DWORD written = 0;
+    if (!WriteFile(handle, chunk, size, &written, nullptr)) return -1;
+    return static_cast<int>(written);
+  }
+private:
+  HANDLE handle = INVALID_HANDLE_VALUE;
+  bool connected = false;
+};
