diff --git a/src/unittests/server/WinRoutePipeTests.cpp b/src/unittests/server/WinRoutePipeTests.cpp
new file mode 100644
index 0000000..2ce3f35
--- /dev/null
+++ b/src/unittests/server/WinRoutePipeTests.cpp
@@ -0,0 +1,36 @@
+#include "server/WinRoutePipe.h"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#define CHECK(value) do { if (!(value)) { std::fprintf(stderr, "failure at line %d (Win32 error %lu)\n", __LINE__, GetLastError()); return 1; } } while (false)
+
+int main()
+{
+  WinRoutePipe pipe, duplicate;
+  const auto name = std::wstring(L"\\\\.\\pipe\\edgebridge-test-") + std::to_wstring(GetCurrentProcessId());
+  CHECK(pipe.listen(name.c_str()));
+  CHECK(!duplicate.listen(name.c_str()));
+  CHECK(!pipe.accept());
+  const auto connect = [&] { return CreateFileW(name.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, 0, nullptr); };
+  HANDLE client = connect();
+  CHECK(client != INVALID_HANDLE_VALUE && pipe.accept());
+  char chunk[32]{};
+  CHECK(pipe.read(chunk, sizeof(chunk)) == 0);
+  DWORD count = 0;
+  CHECK(WriteFile(client, "hel", 3, &count, nullptr) && count == 3);
+  CHECK(pipe.read(chunk, sizeof(chunk)) == 3 && std::memcmp(chunk, "hel", 3) == 0);
+  CHECK(WriteFile(client, "lo\n", 3, &count, nullptr) && count == 3);
+  CHECK(pipe.read(chunk, sizeof(chunk)) == 3 && std::memcmp(chunk, "lo\n", 3) == 0);
+  CHECK(pipe.write("ok\n", 3) == 3);
+  CHECK(ReadFile(client, chunk, sizeof(chunk), &count, nullptr) && count == 3 && std::memcmp(chunk, "ok\n", 3) == 0);
+  CloseHandle(client);
+  CHECK(pipe.read(chunk, sizeof(chunk)) < 0);
+  pipe.disconnect();
+  CHECK(!pipe.accept());
+  client = connect();
+  CHECK(client != INVALID_HANDLE_VALUE && pipe.accept());
+  CloseHandle(client);
+  std::puts("PASS: Windows local named pipe ownership, bidirectional data, EOF and reconnect");
+}
